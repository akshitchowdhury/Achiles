# Copy to the repo root as .env (next to docker-compose.yml) and fill in.
#   cp deploy/.env.example .env && chmod 600 .env
# .env is gitignored.

# Postgres superuser password, shared by the API and RAG service.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Used for embeddings and gpt-4o-mini generation in the RAG service.
OPENAI_API_KEY=

# Signs the session cookie. Required with APP_ENV=production.
#   openssl rand -hex 32
SESSION_SECRET=

# The Vercel URL the app is served from, no trailing slash, e.g.
#   https://achiles.vercel.app
# Also used to build the OAuth redirect URI:
#   ${FRONTEND_URL}/api/auth/oauth/google/callback
# which must be added verbatim to the Google OAuth client.
FRONTEND_URL=

# Google OAuth "Web application" client. Leave empty to run guest-only.
CLIENTID=
CLIENTSECRET=

# How long the API waits for one coach answer. Keep it under the time Vercel's
# proxy will hold a request open.
RAG_TIMEOUT=90s

# Optional — only used to seed plan art into the project-achiles S3 bucket on
# boot. Prefer an IAM instance role with s3:GetObject/PutObject on that bucket
# and leave these empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
