{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/oauth/google/callback",
      "destination": "http://184.194.76.179:8080/api/auth/oauth/google/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "http://184.194.76.179:8080/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
