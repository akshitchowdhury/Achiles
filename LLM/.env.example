# Copy this file to `.env` (same directory) and paste your keys in.
# `.env` is gitignored; this template is safe to commit.
#
# Real environment variables override anything set here, so you can still do
#   $env:OPENAI_API_KEY = "sk-..."
# to try a different key without editing the file.

# --- LLM providers -------------------------------------------------------
# Only one is needed. --provider auto picks the first it finds, in the order
# anthropic > openai > gemini > groq.

# OpenAI -- keys begin with "sk-" (project keys with "sk-proj-")
OPENAI_API_KEY=
# Groq -- keys begin with "gsk_"
GROQ_API_KEY=
# Google Gemini -- keys begin with "AIza"
GEMINI_API_KEY=
# Anthropic -- keys begin with "sk-ant-"
ANTHROPIC_API_KEY=

# --- pgvector store (main.py) --------------------------------------------
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=halo_vectordb
