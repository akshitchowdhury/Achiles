#!/bin/bash
# EC2 user-data: runs once, as root, on the instance's first boot.
# Progress: /var/log/achiles-bootstrap.log  (tail -f it over SSH)
# Rendered by Terraform — $${...} is a literal shell expansion.
set -euxo pipefail
exec > >(tee -a /var/log/achiles-bootstrap.log) 2>&1

REPO_URL="${repo_url}"
GIT_REF="${git_ref}"
APP_DIR=/opt/achiles
COMPOSE_VERSION=v2.39.2
BUILDX_VERSION=v0.26.1

# --- swap: a 1 GB instance can't build the images or run the stack without it
if [ -z "$(swapon --show --noheadings)" ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
echo 'vm.swappiness=10' > /etc/sysctl.d/99-swappiness.conf
sysctl -p /etc/sysctl.d/99-swappiness.conf

# --- docker, compose, buildx (AL2023's docker package ships neither plugin)
dnf install -y docker git
systemctl enable --now docker
usermod -aG docker ec2-user

PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$PLUGINS"
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" -o "$PLUGINS/docker-compose"
curl -fsSL "https://github.com/docker/buildx/releases/download/$BUILDX_VERSION/buildx-$BUILDX_VERSION.linux-amd64" -o "$PLUGINS/docker-buildx"
chmod +x "$PLUGINS/docker-compose" "$PLUGINS/docker-buildx"

# --- code
git clone --depth 1 --branch "$GIT_REF" "$REPO_URL" "$APP_DIR"
chown -R ec2-user:ec2-user "$APP_DIR"
cd "$APP_DIR"

# --- config from SSM Parameter Store (/achiles/*) into .env
bash deploy/write-env.sh

# --- build and start. Slow on a micro: the Go build runs one package at a time.
docker compose up -d --build

# --- wait for the API (it creates the schema on boot), then load the plans
for i in $(seq 1 120); do
  if curl -fsS http://localhost:8080/healthz >/dev/null; then break; fi
  sleep 5
done
curl -fsS http://localhost:8080/healthz
bash deploy/seed.sh

echo "ACHILES BOOTSTRAP COMPLETE"
