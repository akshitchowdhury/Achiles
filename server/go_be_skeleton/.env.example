
APP_ENV=development

# --- HTTP server ---
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# --- Postgres (pgx pool) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for any origin.
# "*" cannot be combined with CORS_ALLOW_CREDENTIALS=true.
#
# The dev client talks to this server through the Vite proxy, so it is
# same-origin and CORS never applies. If you point the client straight at
# :8080 (VITE_API_BASE_URL), the session cookie needs
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
#   CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=300

# --- Google OAuth 2.0 ---
# CLIENTID / CLIENTSECRET come from the "Web application" OAuth client in the
# Google Cloud console (the same values as oauthjson.json).
CLIENTID=
CLIENTSECRET=
# Must be listed verbatim under "Authorised redirect URIs" on that client.
REDIRECTURI=http://localhost:8080/api/auth/oauth/google/callback
# Where the callback sends the browser once sign-in succeeds. Must be listed
# under "Authorised JavaScript origins" on the same client.
FRONTEND_URL=http://localhost:5173

# --- Session cookie ---
# HMAC key for the signed session cookie the callback issues. Any long random
# string; `openssl rand -hex 32` is one way to get one. Required outside
# development — in development an ephemeral one is generated per boot, which
# just means sign-ins do not survive a restart.
SESSION_SECRET=
SESSION_TTL=24h
# Leave false on plain http://localhost; set true behind HTTPS.
SESSION_COOKIE_SECURE=false
